# Скопируйте в .env рядом с docker-compose.yml и заполните значения.
# Этот файл используется контейнером app (env_file) и docker-compose (${VAR} подстановки).

APP_NAME=CarBaseApi
APP_ENV=production
APP_KEY=                      # сгенерировать: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api-driver-3taxi.gram.tj

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Порт, который nginx-контейнер публикует на хосте (сюда проксирует внешний nginx)
APP_PORT=8001

# Тег образов при билде/деплое (можно использовать git sha / версию релиза)
APP_VERSION=latest

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# Собственная БД проекта (default-подключение "mysql") — поднимается контейнером
# mysql из docker-compose.yml. Хост равен имени сервиса в compose-сети.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=car_base_api
DB_USERNAME=car_base_api
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME_ROOT

# -----------------------------------------------------------------------------
# Внешние БД-подключения (другой сервер БД, НЕ контейнеризуются).
# Используются моделями с явным protected $connection = '...':
#   auto_baza        -> ApplicationStatus, BodyType, CarBrand, CarCondition, CarOption,
#                        CategoryCar, City, ClassCar, ColorCar, Gearbox, Marka,
#                        PerformerTransport(*), Rental(*), RentalStatus, RentalTariff, Role
#   mysql_performer   -> DriverCar
#   mysql_location    -> Polygon
# mysql_tele_bot, mysql_asterisk, mysql_test объявлены в config/database.php,
# но на момент подготовки docker-конфига не использовались ни одной моделью —
# проверьте перед продом, действительно ли они нужны.
# -----------------------------------------------------------------------------
DB_CONNECTION_BAZA=mysql
DB_HOST_BAZA=CHANGE_ME_HOST
DB_PORT_BAZA=3306
DB_DATABASE_BAZA=CHANGE_ME
DB_USERNAME_BAZA=CHANGE_ME
DB_PASSWORD_BAZA=CHANGE_ME

DB_CONNECTION_PERFORMER=mysql
DB_HOST_PERFORMER=CHANGE_ME_HOST
DB_PORT_PERFORMER=3306
DB_DATABASE_PERFORMER=CHANGE_ME
DB_USERNAME_PERFORMER=CHANGE_ME
DB_PASSWORD_PERFORMER=CHANGE_ME

DB_CONNECTION_LOCATION=mysql
DB_HOST_LOCATION=CHANGE_ME_HOST
DB_PORT_LOCATION=3306
DB_DATABASE_LOCATION=CHANGE_ME
DB_USERNAME_LOCATION=CHANGE_ME
DB_PASSWORD_LOCATION=CHANGE_ME

DB_CONNECTION_TELE_BOT=mysql
DB_HOST_TELE_BOT=CHANGE_ME_HOST
DB_PORT_TELE_BOT=3306
DB_DATABASE_TELE_BOT=CHANGE_ME
DB_USERNAME_TELE_BOT=CHANGE_ME
DB_PASSWORD_TELE_BOT=CHANGE_ME

DB_CONNECTION_SECOND=mysql
DB_HOST_SECOND=CHANGE_ME_HOST
DB_PORT_SECOND=3306
DB_DATABASE_SECOND=CHANGE_ME
DB_USERNAME_SECOND=CHANGE_ME
DB_PASSWORD_SECOND=CHANGE_ME

DB_CONNECTION_TEST=mysql
DB_HOST_TEST=CHANGE_ME_HOST
DB_PORT_TEST=3306
DB_DATABASE_TEST=CHANGE_ME
DB_USERNAME_TEST=CHANGE_ME
DB_PASSWORD_TEST=CHANGE_ME

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
